      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"cloudops-dev\"}[1m])) by (pod)",
          "legendFormat": "{{pod}} (cores)",
          "refId": "A"
        }
      ],
      "title": "Pod CPU Utilization (Cores)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"cloudops-dev\"}) by (pod)",
          "legendFormat": "{{pod}} (bytes)",
          "refId": "A"
        }
      ],
      "title": "Pod Memory Working Set (Bytes)",
      "type": "timeseries"
    },
    {

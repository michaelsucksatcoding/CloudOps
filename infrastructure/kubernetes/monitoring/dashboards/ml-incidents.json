        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(cloudops_anomalies_detected_total[1m])) by (service)",
          "legendFormat": "{{service}} Anomalies/sec",
          "refId": "A"
        }
      ],
      "title": "ML Anomalies Flagged per Second",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "cloudops_service_health_score",
          "legendFormat": "{{service}} Health",
          "refId": "A"
        }
      ],
      "title": "Service Health Score Trends",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Telemetry Streaming Pipeline Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "events/sec"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(cloudops_telemetry_events_processed_total[1m])) by (service)",
          "legendFormat": "{{service}} Processed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cloudops_telemetry_events_failed_total[1m])) by (service)",
          "legendFormat": "{{service}} Failed",
          "refId": "B"
        }
      ],
      "title": "Telemetry Events Throughput (Processed vs Failed)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cloudops_ml_inference_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Inference Latency",
          "refId": "A"
        }
      ],
      "title": "ML Model Inference Latency (P95)",
      "type": "timeseries"
